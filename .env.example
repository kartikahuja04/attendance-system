# FastAPI & MongoDB configuration
ENV=development
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=attendance_system
# Example Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/attendance_system?retryWrites=true&w=majority

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173